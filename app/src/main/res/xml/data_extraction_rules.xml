<?xml version="1.0" encoding="utf-8"?>
<!-- Ab Android 12: Zugangsdaten (GitHub-Token) weder ins Cloud-Backup noch auf ein neues Gerät übertragen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
