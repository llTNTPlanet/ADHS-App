<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kennzeichnet die App als Uhr-App (Wear OS). -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Erinnerungen anzeigen (auf der Uhr sind Benachrichtigungen neuer Apps zunächst aus) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Klingeln: Die Uhr-App vibriert selbst, solange eine Erinnerung klingelt -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        Wirkt nur nach „adb shell appops set de.lltntplanet.adhsapp SYSTEM_ALERT_WINDOW allow“:
        Dann darf die Uhr-App ihr Vollbild von selbst öffnen. Ohne das klingelt sie trotzdem.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Die Klassen stehen voll ausgeschrieben da: namespace (…adhsapp.wear) ist nicht die applicationId. -->
    <application
        android:name="de.lltntplanet.adhsapp.wear.WearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Die Uhr-App braucht die Handy-App: Das Handy plant die Erinnerungen und liefert die Übersicht. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name="de.lltntplanet.adhsapp.wear.MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Vollbild einer Erinnerung: nur Oberfläche, geklingelt wird im AlertRingService.
            Eigene Aufgabe, über dem Sperrbildschirm, nicht in der Liste der letzten Apps. Bewusst ohne noHistory:
            Legt sich kurz etwas darüber, soll das Vollbild danach wieder da sein.
        -->
        <activity
            android:name="de.lltntplanet.adhsapp.wear.alert.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="de.lltntplanet.adhsapp.alert"
            android:turnScreenOn="true"
            tools:ignore="WearRecents" />

        <!-- Nachrichten und Daten vom Handy: klingeln, Erinnerung entfernen, neue Übersicht. -->
        <service
            android:name="de.lltntplanet.adhsapp.wear.link.WatchListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/adhs"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Klingelt (vibriert), bis die Erinnerung bestätigt ist oder die Klingelzeit abläuft. -->
        <service
            android:name="de.lltntplanet.adhsapp.wear.alert.AlertRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Vom Nutzer eingestellte Erinnerung (wie ein Wecker), ausgelöst vom gekoppelten Handy" />
        </service>

        <!-- Knöpfe in der Benachrichtigung einer Erinnerung -->
        <receiver
            android:name="de.lltntplanet.adhsapp.wear.alert.AlertActionReceiver"
            android:exported="false" />
    </application>

</manifest>
